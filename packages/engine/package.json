{
  "name": "@claimcast/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ClaimCast deterministic adjudication core. No I/O, no framework, no network.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./fixtures": "./src/fixtures.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "esbuild src/selfcheck.ts --bundle --platform=node --format=cjs --outfile=node_modules/.selfcheck.cjs && node node_modules/.selfcheck.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  }
}
