# Build output of src/build_poster.py. finalize.ps1 copies these to the
# submission filenames, which ARE tracked.
Team Rocket_IIIT Delhi - C Poster.pptx
Team Rocket_IIIT Delhi - C Poster.pdf

__pycache__/
*.py[cod]

# PowerPoint / Office lock and autosave files
~$*
*.tmp

.DS_Store
Thumbs.db

# ClaimCast application. npm workspaces, so node_modules appears at the root
# and inside any workspace that needs its own copy. The root lockfile IS
# tracked — it is the only record of what the build actually resolved.
node_modules/
dist/
.env
.env.*
!.env.example

# Python services and ETL
.venv/
venv/

# Raw public datasets pulled by the ETL. Large, re-downloadable, and their
# checksums are tracked in the manifest instead.
etl/raw/

# Encrypted policy uploads. Encrypted or not, someone's schedule does not belong
# in a repository, and the retention sweep cannot delete what git is holding.
apps/api/.vault/
