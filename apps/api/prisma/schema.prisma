// ClaimCast reference data.
//
// The shape follows packages/engine/src/types.ts closely, because the engine is
// the consumer and a schema that drifts from it just means mapping code. One
// thing types.ts has no reason to carry is added here: every row that carries a
// price points at the Source it came from. A rate we cannot attribute is a rate
// we cannot put in front of a judge, and making the relation required is how
// that stays true under deadline pressure.
//
// Money is paise, as integers, everywhere. Postgres Int tops out around
// 2.1 billion, which is 21.4 crore rupees — comfortably above any sum insured
// or bill this system will see, and keeping it Int rather than BigInt is what
// lets the engine read these values as plain JS numbers without conversion.

generator client {
  provider      = "prisma-client-js"
  // "native" is whatever machine runs `prisma generate` — a laptop, usually.
  // The second target is Cloud Run's runtime, and it has to be named explicitly
  // because Prisma detects the platform of the machine generating, not the one
  // deploying. Inside a slim build image with no OpenSSL installed it guesses
  // debian-openssl-1.1.x, the runtime image has 3.0.x, and the container starts
  // cleanly and then fails on its first query with a message about a missing
  // query engine. Naming the target is what makes that impossible.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Provenance ────────────────────────────────────────────────────────────

/// Where a figure came from. One row per published document, so a rate can
/// always be traced back to the exact file and the day it was fetched.
model Source {
  id        String   @id
  name      String
  publisher String
  url       String
  /// Of the downloaded file, so we can tell if the publisher revised it.
  checksum  String?
  fetchedAt DateTime
  /// Set where the source is not yet verified, so unverified figures are
  /// queryable rather than a thing someone has to remember.
  caveat    String?

  hospitals   Hospital[]
  tariffRates TariffRate[]
  nonPayables NonPayableItem[]
  policies    Policy[]
  clauses     Clause[]

  @@map("sources")
}

// ── Reference data ────────────────────────────────────────────────────────

enum CityTier {
  X
  Y
  Z
}

enum RoomClass {
  general
  semi_private
  private
  deluxe
  suite
  icu
}

enum TariffScheme {
  PMJAY
  CGHS
}

enum IrdaiList {
  I
  II
  III
  IV
}

enum Route {
  cashless
  reimbursement
}

model Hospital {
  id   String   @id
  name String
  city String
  /// NHA city classification. Drives the CGHS rate band.
  tier CityTier
  beds Int

  pmjayEmpanelled Boolean
  /// ESIC tie-up for referred secondary and super-speciality care.
  esicTieUp       Boolean  @default(false)
  cghsRateBand    CityTier?

  /// Synthetic. No public source publishes what a named private hospital
  /// charges per bed-day, so this and the room tariffs below are modelled,
  /// not observed, and must stay labelled that way wherever they surface.
  costIndex      Float
  settlementDays Int
  /// Median cashless pre-authorisation turnaround, in hours.
  preAuthHours   Int?
  flags          String[]

  rooms   HospitalTariff[]
  network HospitalNetwork[]

  sourceId String
  source   Source @relation(fields: [sourceId], references: [id])

  admissions Admission[]

  @@index([city])
  @@map("hospitals")
}

/// Which insurers hold a cashless network agreement with this hospital.
model HospitalNetwork {
  hospitalId String
  insurer    String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@id([hospitalId, insurer])
  @@map("hospital_network")
}

model HospitalTariff {
  hospitalId String
  cls        RoomClass
  /// Paise per day.
  perDay     Int
  hospital   Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@id([hospitalId, cls])
  @@map("hospital_tariffs")
}

model Procedure {
  id             String  @id
  name           String
  /// PM-JAY Health Benefit Package code, where one exists.
  hbpCode        String?
  specialty      String
  /// True where the procedure sits on the policy's day-care list, so the
  /// 24-hour in-patient rule does not apply.
  dayCare        Boolean
  medianStayDays Int
  usesImplant    Boolean

  /// Observed private-sector spread, before any room-class effect.
  privateLow  Int
  privateHigh Int

  // Enough to rebuild a bill line by line. Flattened from CostModel, because
  // a JSON blob here would not be queryable and these are the columns the ML
  // service in Phase 4 needs to predict against.
  surgical         Int
  nursingPerDay    Int
  icuPerDay        Int?
  diagnostics      Int
  pharmacyPerDay   Int
  implant          Int?
  otherIndependent Int
  nonPayableFixed  Int
  nonPayablePerDay Int
  outsideWindow    Int

  implantOptions ImplantOption[]
  tariffRates    TariffRate[]
  admissions     Admission[]

  @@index([specialty])
  @@map("procedures")
}

/// One device the procedure can be billed with, where a real choice exists
/// between an imported part and a domestic one at the same clinical spec.
model ImplantOption {
  id          String
  procedureId String
  label       String
  amount      Int
  procedure   Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@id([procedureId, id])
  @@map("implant_options")
}

/// A published government rate for a procedure. PM-JAY package rates are
/// national; CGHS rates vary by city tier and by whether the hospital is
/// NABH accredited, which is why this is a table and not two columns.
model TariffRate {
  id          String       @id @default(cuid())
  procedureId String
  scheme      TariffScheme

  /// Null on a national figure that no city tier qualifies, which is what
  /// PM-JAY's National Reference Price is.
  cityTier CityTier?
  nabh     Boolean?

  /// Whether `amount` buys the whole episode or one day of it.
  ///
  /// PM-JAY prices a surgical package outright and a medical admission by bed
  /// category per day, and the difference is not presentational: 228 of the
  /// 1,949 packages in HBP 2022 carry no episode price at all, only a per-day
  /// grid. Collapsing those into one number would mean either dropping the
  /// published rate or multiplying it by a stay length nobody published.
  basis TariffBasis @default(PACKAGE)

  /// Which bed the per-day rate is for: `routine-ward`, `high-dependency`,
  /// `icu-no-ventilator` or `icu-ventilator`. Null on a PACKAGE row.
  bedCategory String?

  /// Paise. The whole episode on a PACKAGE row, one day on a PER_DAY row.
  amount        Int
  effectiveFrom DateTime

  procedure Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  sourceId  String
  source    Source    @relation(fields: [sourceId], references: [id])

  @@unique([procedureId, scheme, cityTier, nabh, basis, bedCategory, effectiveFrom])
  @@map("tariff_rates")
}

enum TariffBasis {
  PACKAGE
  PER_DAY
}

model Policy {
  id         String @id
  insurer    String
  product    String
  sumInsured Int

  /// Either an absolute figure or a percentage of sum insured. Where a policy
  /// states both, the tighter binds — that arithmetic lives in the engine.
  roomCapPerDay  Int?
  roomCapPctOfSI Float?
  icuCapPerDay   Int?
  icuCapPctOfSI  Float?

  /// Some products buy the clause out. When false, no scaling ever happens.
  proportionateDeduction Boolean
  copayPct               Float
  implantSubLimit        Int?
  preHospDays            Int
  postHospDays           Int
  dayCareCovered         Boolean

  /// Months elapsed on this policy. Drives waiting periods and the moratorium.
  monthsInForce    Int
  pedWaitingMonths Int
  moratoriumMonths Int
  /// The wording's exclusions, as read and confirmed. Null where no document was read.
  exclusions       String?
  notes            String?

  sourceId String
  source   Source @relation(fields: [sourceId], references: [id])

  admissions Admission[]
  documents  PolicyDocument[]

  @@map("policies")
}

/// A clause that can be cited as the cause of a deduction.
model Clause {
  id         String  @id
  cite       String
  text       String
  /// The engine's own one-line attribution, e.g. "IRDAI circular, 11 June 2020".
  /// Kept verbatim beside the Source relation rather than derived from it, so a
  /// round trip through the database returns the identical Clause object.
  sourceText String
  /// Deep link to the clause in the published document, where one exists.
  url        String?

  sourceId String
  source   Source @relation(fields: [sourceId], references: [id])

  @@map("clauses")
}

/// IRDAI Lists I-IV. List I is the one that matters most: items never payable
/// under any policy, in any room.
model NonPayableItem {
  id   String    @id @default(cuid())
  list IrdaiList

  /// True for a row transcribed from the published annexure, false for a row
  /// ClaimCast models. The table holds both on purpose and never blends them:
  /// IRDAI publishes item names and nothing else, so a priced row cannot carry
  /// the regulator's provenance. `published` is what keeps the two apart, and
  /// `listI()` reads only the modelled side.
  published Boolean @default(true)

  /// Position in the published annexure. Set on published rows, null on
  /// modelled ones, which are a basket rather than a numbered list.
  serial Int?

  /// The item name. On a published row this is verbatim, capitals and all. On
  /// a modelled row it is ClaimCast's own sentence-case phrasing.
  label String

  /// ClaimCast's grouping, for the screen that shows the basket. IRDAI files
  /// its items under no headings at all, so this is null on published rows.
  group String?

  /// Illustrative amount on a five-day metro admission, in paise. Modelled
  /// from the item's nature; IRDAI publishes no prices, so this is null on
  /// every published row and the source of a priced row is never IRDAI.
  typical Int?

  sourceId String
  source   Source @relation(fields: [sourceId], references: [id])

  @@unique([list, published, label])
  @@map("non_payable_items")
}

/// What each of the four lists does. IRDAI publishes four; only List I costs
/// the patient directly, and the other three are here because explaining why
/// they do not is part of the answer.
model IrdaiListInfo {
  id     IrdaiList @id
  title  String
  effect String

  @@map("irdai_lists")
}

/// A settled admission, kept as a reference case. Every one is synthetic and
/// chosen for what it breaks — a room exactly at the sub-limit, a claim refused
/// five hours short of twenty-four, a sum insured that ran out in March.
model Admission {
  id  String @id
  /// Synthetic patient reference. No real person.
  ref String

  date        DateTime
  hospitalId  String
  procedureId String
  policyId    String
  roomClass   RoomClass
  route       Route

  /// Bill lines as stored, each already classified by LineKind. Kept as JSON
  /// because these are a frozen historical record rather than something the
  /// application edits, and normalising them would buy nothing.
  lines Json

  /// What made this record worth keeping in the reference set.
  edgeCase         String?
  /// Sum insured already consumed this policy year, before this admission.
  siUsed           Int?
  /// Set where the claim was refused outright rather than reduced.
  repudiatedReason String?
  repudiatedClause String?

  hospital  Hospital  @relation(fields: [hospitalId], references: [id])
  procedure Procedure @relation(fields: [procedureId], references: [id])
  policy    Policy    @relation(fields: [policyId], references: [id])

  @@map("admissions")
}

// ── Learning ──────────────────────────────────────────────────────────────

// Three places in this application reality answers back, and each one is a
// chance to be less wrong next time:
//
//   1. A person corrects a figure the reader got out of their schedule.
//   2. A bill finally settles, and we can see where in our own band it fell.
//   3. Someone clicks a branch, which says what decisions people actually face.
//
// All three update on arrival. There is no training run, no retrained artifact
// to ship, and nothing here waits for a batch job: an observation written by one
// request changes what the next request does. That is the whole point — a model
// fitted once is a snapshot of the day it was fitted, and this problem does not
// hold still. Room rent sub-limits move, hospitals reprice, and schedules get
// redesigned by the insurers who issue them.
//
// What the tables may keep is deliberately uneven. Counters carry no
// information about any person and are always written. The verbatim text of
// someone's policy schedule is kept only where they have said it may be, and
// the shape of these models is what enforces that: the columns that could
// identify a document are nullable, and the aggregate that drives the product
// never reads them.

/// One human judgment on one extracted field.
///
/// Written when a person accepts or corrects what the reader pulled out of
/// their schedule. The row that always exists is the verdict — this field, this
/// model, was it changed — because that is what the reliability table is built
/// from and it says nothing about anybody.
///
/// `readValue`, `confirmedValue` and `spanText` are the person's own policy
/// terms, and they are null unless that person ticked the box. They exist to be
/// shown back to the reader as worked examples, which is the one use consent
/// was asked for.
model FieldObservation {
  id         String @id @default(cuid())
  documentId String
  /// The contracts field name, e.g. "roomCapPerDay".
  field      String
  /// provider/model as recorded on the extraction, e.g. "vertex/gemini-2.5-pro".
  model      String

  /// Whether the model's citation was found in the PDF's own text.
  verified  Boolean
  /// Whether the person changed the value before confirming it.
  corrected Boolean

  /// Null unless consent was given. See the note on this section.
  readValue      String?
  confirmedValue String?
  spanText       String?

  createdAt DateTime @default(now())

  document PolicyDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([field, model])
  @@index([documentId])
  @@map("field_observations")
}

/// How far each field can be trusted, as of the last document read.
///
/// A running tally rather than a computed view, because it is read on every
/// extraction and counting a growing table each time would make the read cost
/// grow with use. Updated in the same transaction as the confirmation, so it is
/// never ahead of or behind the observations it summarises.
///
/// The product effect is immediate and visible: a field that people keep
/// correcting is flagged on the next person's screen before they have read it.
/// That is the honest use of this number — it does not make the reader better,
/// it tells the human where to look.
model FieldReliability {
  field String
  model String

  /// Confirmations seen for this field.
  seen       Int @default(0)
  /// Of those, how many the person changed.
  corrected  Int @default(0)
  /// Of those, how many cited a quote that was not in the document.
  unverified Int @default(0)

  updatedAt DateTime @updatedAt

  @@id([field, model])
  @@map("field_reliability")
}

/// A bill that actually settled, against the band we predicted for it.
///
/// This is the only row in the system that can say whether the forecast was
/// any good, and it can only come from a person telling us what they ended up
/// paying. It is therefore rare and voluntary, and the honest description of
/// this table on any given day is its row count.
///
/// Amounts are paise, like everywhere else. The prediction is stored beside the
/// outcome rather than recomputed, because the point of the row is to record
/// what this system said at the time, not what it would say now.
model ForecastOutcome {
  id     String  @id @default(cuid())
  userId String?

  /// The forecast request that produced the band, as sent.
  request Json

  p10 Int
  p50 Int
  p90 Int

  /// What the admission actually came to.
  actualTotal Int
  /// The published tariff the band was anchored on, so the ratio this row
  /// implies can be recovered without re-reading the tariff table as it is
  /// today. Null where the forecast had no anchor.
  anchorTotal Int?

  /// Denormalised from the request so the calibration query does not have to
  /// dig through JSON on every read.
  procedureId String
  cityTier    String
  /// Where the admission was. Recorded, not priced from.
  hospitalId  String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([procedureId, cityTier])
  @@map("forecast_outcomes")
}

/// What people actually chose, one row per branch taken.
///
/// The weakest of the three signals and the one to be most careful describing:
/// it tunes what the tree offers first, and it does not make any number more
/// accurate. Kept anyway because the ordering of a decision tree is itself a
/// claim about what matters, and guessing at that when the clicks are sitting
/// right there is a waste.
///
/// No owner column. A branch click is not worth attaching to a person, and not
/// attaching it means this table cannot become a record of what any individual
/// was contemplating.
model BranchChoice {
  id String @id @default(cuid())

  /// The decision point, e.g. "roomClass".
  stage  String
  /// The option taken at it, e.g. "twin-sharing".
  option String

  createdAt DateTime @default(now())

  @@index([stage, option])
  @@map("branch_choices")
}

// ── Application state ─────────────────────────────────────────────────────

/// A person, or a browser that has not said who it is yet.
///
/// Both are the same row. A session is created on first contact so that a case
/// and an uploaded schedule have an owner from the moment they exist, and `email`
/// is null until someone chooses to name themselves. That ordering is deliberate:
/// scoping someone's financial document to an account they have not made yet is
/// not possible, and leaving it unscoped until they do is the thing to avoid.
model User {
  id           String   @id @default(cuid())
  /// Null for a session that has not been claimed with an email.
  email        String?  @unique
  /// scrypt, with the salt and parameters stored alongside the hash.
  passwordHash String?
  name         String?
  createdAt    DateTime @default(now())

  cases     Case[]
  documents PolicyDocument[]
  outcomes  ForecastOutcome[]

  @@map("users")
}

/// A forecast someone ran and kept. The input is stored rather than the
/// output, so reopening a saved case re-adjudicates it with the current
/// engine instead of showing a figure that may no longer be defensible.
model Case {
  id        String   @id @default(cuid())
  userId    String?
  input     Json
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("cases")
}

/// An uploaded policy schedule and what was extracted from it.
///
/// These are real people's financial documents. The file itself lives in
/// object storage, never in this table; `confirmedAt` records the moment the
/// user accepted the extraction, and nothing may reach the engine before it.
model PolicyDocument {
  id          String    @id @default(cuid())
  userId      String?
  policyId    String?
  filename    String
  storageKey  String
  /// Extracted fields, each with the verbatim span it came from.
  extraction  Json?
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())

  user         User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  policy       Policy?            @relation(fields: [policyId], references: [id], onDelete: SetNull)
  observations FieldObservation[]

  @@index([userId])
  @@map("policy_documents")
}
