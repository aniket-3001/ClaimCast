{
  "name": "@claimcast/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ClaimCast API. Serves reference data and is authoritative for any figure that gets persisted.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "check": "tsx prisma/verify.ts && tsx src/extract.check.ts && tsx src/session.check.ts && tsx src/learning.check.ts && tsx src/rag.check.ts",
    "extract:live": "tsx src/extract.live.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@claimcast/contracts": "*",
    "@claimcast/engine": "*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.4",
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "pdfjs-dist": "^6.3.289",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
