# Copy to .env and fill in. .env is gitignored; this file is not.

# Local Postgres, as brought up by infra/docker-compose.yml.
POSTGRES_USER=claimcast
POSTGRES_PASSWORD=claimcast
POSTGRES_DB=claimcast
POSTGRES_PORT=5434
DATABASE_URL=postgresql://claimcast:claimcast@localhost:5434/claimcast?schema=public

# Policy extraction (Phase 5). Server-side only; these keys must never be
# reachable from the web bundle.
#
# Set whichever you have. The first one configured wins, in the order below, and
# apps/api/src/models.ts explains why that is the order: Vertex, Gemini and
# Anthropic are handed the PDF itself, Groq is handed text that pdf.js has
# flattened out of a grid. Upload returns 503 and says so when none is set.
#
# Vertex is first and is the one the deployment uses. It reaches the same Gemini
# models through Google Cloud rather than AI Studio, which means two things: it
# bills to the Cloud project, where the credit is, and it authenticates with the
# service account instead of an API key -- so there is no long-lived secret to
# store, rotate or leak. Set it to the project id; VERTEX_LOCATION defaults to
# us-central1. Locally there is no metadata server, so export GOOGLE_ACCESS_TOKEN
# as well:  GOOGLE_ACCESS_TOKEN=$(gcloud auth print-access-token)
VERTEX_PROJECT=
VERTEX_LOCATION=
# The AI Studio key, which is a different billing arrangement from Vertex and is
# not funded by Google Cloud credit. On this account it answers 429 "prepayment
# credits are depleted" on every model, which is why the deployment uses Vertex.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# The ML service (Phase 4). Left empty until services/ml actually exists: with
# no URL the forecast endpoint returns 503 and says why, which is the honest
# answer. Pointing it at a service that is not there would turn that into a
# gateway error and hide the real state of things.
ML_SERVICE_URL=http://localhost:8001
# Settled bills the cost model has not been trained on before the API asks it
# to rebuild its XGBoost booster on the combined pool. See services/ml/app.py.
RETRAIN_EVERY=10

# The API. 3001 was taken on the development machine this was set up on, so the
# port is offset like the database's is.
PORT=3101
HOST=0.0.0.0

# Comma-separated origins allowed to call the API from a different origin.
# Normally empty, and empty in production too: the container serves the web
# bundle itself, so the browser never makes a cross-origin call and CORS is never
# consulted. Only fill this in if the app is ever hosted somewhere else -- and
# read the static block in apps/api/src/server.ts first, because a cross-origin
# deployment also puts the session cookie at the mercy of third-party cookie
# blocking, which fails silently rather than loudly.
WEB_ORIGIN=

# Where the built web bundle is. Unset means apps/web/dist relative to the
# source, which is right on a laptop; the image sets it to /app/web. If the
# directory has no index.html the process serves the API alone and logs that it
# is doing so, which is what happens in development -- there Vite serves the app.
WEB_DIST=

# Uploaded policy schedules (Phase 5). The API refuses uploads outright when this
# is unset -- there is deliberately no plaintext fallback. 32 bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DOCUMENT_ENCRYPTION_KEY=
# How long an encrypted upload is kept before it is deleted. Seven days is longer
# than a demo needs and shorter than anyone would want their schedule kept.
DOCUMENT_RETENTION_DAYS=7
# Where the encrypted files live. Defaults to apps/api/.vault, which is gitignored.
DOCUMENT_DIR=
# Force one provider instead of taking the first one configured: vertex | gemini
# | anthropic | groq. Useful for comparing two readings of the same schedule, and
# for pinning Groq on the day: it is about six times faster than Gemini Pro on
# the mockup schedule (roughly 4s against 26s) at the same accuracy, which is
# worth knowing before a live upload in front of anyone. Unset normally.
EXTRACTION_PROVIDER=
# Override the model within a provider. The defaults are gemini-2.5-pro on
# Vertex, gemini-3.1-pro-preview on AI Studio -- they differ because Vertex does
# not serve the 3.x names and AI Studio no longer serves 2.5 to new keys --
# claude-sonnet-5, and openai/gpt-oss-120b. Pro rather than Flash is deliberate:
# the difference is under two rupees an upload on a page of sub-limits a person
# is then asked to confirm. Switch to Flash if volume ever matters.
VERTEX_MODEL=
GEMINI_MODEL=
ANTHROPIC_MODEL=
GROQ_MODEL=

# Signs the session cookie, at least 32 characters. Rotating it signs everyone
# out; no data is lost. Generate one, do not reuse a key from anywhere else.
SESSION_SECRET=
