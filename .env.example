# Copy to .env and fill in. .env is gitignored; this file is not.

# Local Postgres, as brought up by infra/docker-compose.yml.
POSTGRES_USER=claimcast
POSTGRES_PASSWORD=claimcast
POSTGRES_DB=claimcast
POSTGRES_PORT=5434
DATABASE_URL=postgresql://claimcast:claimcast@localhost:5434/claimcast?schema=public

# Policy extraction (Phase 5). Server-side only; this key must never be
# reachable from the web bundle.
ANTHROPIC_API_KEY=

# The ML service (Phase 4). Left empty until services/ml actually exists: with
# no URL the forecast endpoint returns 503 and says why, which is the honest
# answer. Pointing it at a service that is not there would turn that into a
# gateway error and hide the real state of things.
ML_SERVICE_URL=

# The API. 3001 was taken on the development machine this was set up on, so the
# port is offset like the database's is.
PORT=3101
HOST=0.0.0.0

# Comma-separated origins allowed to call the API in production. Empty in
# development, where the client goes through Vite's proxy and is same-origin.
WEB_ORIGIN=
